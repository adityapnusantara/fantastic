# Copy to .env and fill in. .env is gitignored.

# --- Local stack (docker compose) ---
POSTGRES_USER=fantastic
POSTGRES_PASSWORD=fantastic-dev
POSTGRES_DB=fantastic
POSTGRES_PORT=5555
CASDOOR_PORT=5560
APP_PORT=5580

# Connection string used by `fantastic migrate` / `fantastic api`
DATABASE_URL=postgres://fantastic:fantastic-dev@localhost:5555/fantastic

# --- Casdoor (dev seed values; localhost-only) ---
CASDOOR_CLIENT_SECRET=fantastic-dev-secret-123

# --- External services ---
# Required for real chat completions
OPENAI_API_KEY=
# Required for the Tebar MCP demo tools (https://api.tebar.app/mcp)
TEBAR_MCP_TOKEN=
